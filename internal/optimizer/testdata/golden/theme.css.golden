:root{--black-text:#000000;--accent:#ff6600;--space:calc(1rem + 2px)}.post-list a :hover,.post-list>li+li{color:var(--accent);margin:0 .5em}.hero::before{content:"/* not a comment */";background:url("/images/hero bg.png")no-repeat}@media(min-width:768px) and (max-width:1024px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@font-face{font-family:inter;src:url(/fonts/inter.woff2)format("woff2");unicode-range:U+??}.fade{transition:opacity 0s ease .25s}